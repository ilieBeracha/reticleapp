# =============================================================================
# Reticle app — environment template
# Copy to `.env` or `.env.local` and fill in values (never commit real secrets).
# Expo loads `.env` from the project root for local dev; `EXPO_PUBLIC_*` vars are
# inlined into the client bundle.
# =============================================================================

# --- App variant (local dev / overrides EAS profile when set here) ----------
# development | preview | production
APP_VARIANT=development

# --- Expo public (bundled into the app) --------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_DETECT_BASE_URL=
EXPO_PUBLIC_OPENWEATHER_API_KEY=
# Optional: Expo project UUID for push token registration (see app.config.js extra.eas.projectId)
EXPO_PUBLIC_PROJECT_ID=

# =============================================================================
# Supabase Edge Functions (Deno) — configure as secrets in the Supabase
# dashboard, or use `supabase secrets set` for deployed functions. Not read
# from this file in production unless you wire local Deno tooling yourself.
# =============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
ANTHROPIC_API_KEY=

# =============================================================================
# EAS Workflows (.eas/workflows/deploy_production.yml) — set on the EAS
# “production” environment / project secrets, not in a local .env for the app.
# =============================================================================
SUPABASE_DB_PASSWORD=
SUPABASE_PROD_DB_HOST=
SUPABASE_PROD_PROJECT_REF=
SLACK_WEBHOOK_URL=
